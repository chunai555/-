:root {
  --petal: #e4c8d0;
  --blue-gray: #a2afc4;
  --soft-white: #f8f6f2;
  --black: #111115;
  --taro: #e4c8d0;
  --cream: #f8f6f2;
  --custard: #e4c8d0;
  --lilac: #a2afc4;
  --ink: #111115;
  --night: #2a2c34;
  --leaf: #a2afc4;
  --leaf-bright: #e4c8d0;
  --gold: #f8f6f2;
  --lavender: #a2afc4;
  --mist: rgba(248, 246, 242, 0.82);
  --line: rgba(248, 246, 242, 0.26);
  --panel: rgba(17, 17, 21, 0.68);
  --text: #f8f6f2;
  --muted: rgba(248, 246, 242, 0.68);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  color: var(--text);
  background:
    radial-gradient(circle at 12% 9%, rgba(248, 246, 242, 0.32), transparent 23rem),
    radial-gradient(circle at 78% 6%, rgba(228, 200, 208, 0.46), transparent 25rem),
    linear-gradient(180deg, #e4c8d0 0%, #c9c2cf 45%, #a2afc4 76%, #111115 100%);
  font-family:
    "Noto Serif SC", "Songti SC", "Microsoft YaHei", "PingFang SC", serif;
}

body.is-loading {
  overflow: hidden;
}

body.is-playing .site-header {
  border-color: rgba(248, 246, 242, 0.42);
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

.opening {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: grid;
  place-items: center;
  pointer-events: auto;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 50%, rgba(239, 207, 117, 0.08), transparent 18rem),
    #030304;
  cursor: none;
}

.opening::before,
.opening::after {
  position: absolute;
  inset: 0;
  content: "";
  pointer-events: none;
}

.opening::before {
  background:
    radial-gradient(circle at 50% 52%, rgba(250, 222, 126, 0.13), transparent 18rem),
    radial-gradient(circle at 50% 86%, rgba(228, 200, 208, 0.08), transparent 28rem);
  opacity: 0;
  will-change: opacity, transform;
}

.opening::after {
  background-image:
    radial-gradient(circle, rgba(255, 239, 180, 0.75) 0 1px, transparent 1.5px),
    radial-gradient(circle, rgba(248, 246, 242, 0.38) 0 1px, transparent 1.4px);
  background-position:
    8vw 18vh,
    62vw 24vh;
  background-size:
    22rem 18rem,
    17rem 21rem;
  mix-blend-mode: screen;
  opacity: 0.1;
  animation: openingDust 9s linear infinite;
}

.opening-veil {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 50% 52%, transparent 0 7rem, rgba(3, 3, 4, 0.78) 18rem, rgba(3, 3, 4, 0.96) 100%),
    linear-gradient(180deg, rgba(3, 3, 4, 0.98), rgba(8, 7, 8, 0.88) 54%, rgba(3, 3, 4, 0.98));
  pointer-events: none;
}

.opening-landscape {
  position: absolute;
  inset: auto -8vw 0;
  height: 38vh;
  background:
    radial-gradient(ellipse at 13% 98%, rgba(248, 246, 242, 0.18), transparent 23%),
    radial-gradient(ellipse at 84% 102%, rgba(228, 200, 208, 0.13), transparent 27%),
    linear-gradient(7deg, transparent 0 44%, rgba(248, 246, 242, 0.07) 44.4% 46%, transparent 46.5%),
    linear-gradient(-8deg, transparent 0 54%, rgba(248, 246, 242, 0.05) 54.4% 56%, transparent 56.4%),
    linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.84) 82%);
  filter: blur(0.2px);
  opacity: 0;
  transform: translateY(22px);
  pointer-events: none;
}

.opening-landscape::before,
.opening-landscape::after {
  position: absolute;
  bottom: 0;
  content: "";
  opacity: 0.72;
  transform-origin: bottom center;
}

.opening-landscape::before {
  left: 8vw;
  width: 34vw;
  height: 30vh;
  background:
    linear-gradient(82deg, transparent 0 46%, rgba(248, 246, 242, 0.09) 46.5% 48%, transparent 48.5%),
    radial-gradient(ellipse at 28% 54%, rgba(248, 246, 242, 0.1), transparent 10%),
    radial-gradient(ellipse at 44% 38%, rgba(248, 246, 242, 0.08), transparent 8%),
    radial-gradient(ellipse at 62% 61%, rgba(248, 246, 242, 0.08), transparent 9%);
}

.opening-landscape::after {
  right: 8vw;
  width: 44vw;
  height: 25vh;
  background:
    linear-gradient(-66deg, transparent 0 56%, rgba(248, 246, 242, 0.08) 56.5% 58%, transparent 58.5%),
    radial-gradient(ellipse at 42% 47%, rgba(248, 246, 242, 0.09), transparent 9%),
    radial-gradient(ellipse at 58% 64%, rgba(248, 246, 242, 0.08), transparent 8%),
    radial-gradient(ellipse at 76% 42%, rgba(248, 246, 242, 0.07), transparent 8%);
}

.opening-particles {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.opening-particles::before,
.opening-particles::after {
  position: absolute;
  left: 0;
  top: 0;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  content: "";
  background: #ffe88d;
  box-shadow:
    0 -118px 0 rgba(255, 238, 172, 0.78),
    98px -78px 0 rgba(255, 238, 172, 0.68),
    142px 22px 0 rgba(255, 238, 172, 0.72),
    72px 112px 0 rgba(255, 238, 172, 0.66),
    -28px 138px 0 rgba(255, 238, 172, 0.72),
    -122px 62px 0 rgba(255, 238, 172, 0.7),
    -108px -78px 0 rgba(255, 238, 172, 0.64),
    18px -172px 0 rgba(248, 246, 242, 0.58),
    188px -22px 0 rgba(248, 246, 242, 0.52),
    -186px 6px 0 rgba(248, 246, 242, 0.58);
  filter: drop-shadow(0 0 13px rgba(255, 220, 100, 0.72));
  transform: translate(-50%, -50%) scale(0.08);
}

.opening-particles::after {
  width: 4px;
  height: 4px;
  box-shadow:
    42px -84px 0 rgba(255, 238, 172, 0.64),
    132px -126px 0 rgba(255, 238, 172, 0.5),
    204px 74px 0 rgba(255, 238, 172, 0.46),
    30px 190px 0 rgba(255, 238, 172, 0.58),
    -86px 164px 0 rgba(255, 238, 172, 0.52),
    -176px -24px 0 rgba(255, 238, 172, 0.58),
    -70px -160px 0 rgba(248, 246, 242, 0.48),
    232px -146px 0 rgba(248, 246, 242, 0.44),
    -238px 116px 0 rgba(248, 246, 242, 0.48);
}

.firefly-trigger {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 2;
  width: clamp(104px, 18vw, 168px);
  height: clamp(104px, 18vw, 168px);
  border: 0;
  border-radius: 50%;
  padding: 0;
  background: transparent;
  cursor: pointer;
  transform: translate(-50%, -50%);
  will-change: transform, opacity, filter;
}

.firefly-trigger:hover .firefly-aura,
.firefly-trigger:focus-visible .firefly-aura {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1.08);
}

.firefly-trigger:focus-visible {
  outline: 1px solid rgba(255, 238, 172, 0.8);
  outline-offset: 18px;
}

.firefly-aura,
.firefly-wings,
.firefly-core {
  position: absolute;
  left: 50%;
  top: 50%;
  pointer-events: none;
  transform: translate(-50%, -50%);
}

.firefly-aura {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background:
    radial-gradient(circle, rgba(255, 238, 172, 0.72) 0 7%, rgba(255, 220, 101, 0.36) 18%, rgba(255, 220, 101, 0.1) 38%, transparent 68%);
  filter: blur(4px);
  opacity: 0;
  animation: fireflyBreath 2.8s ease-in-out infinite;
  transition:
    opacity 0.7s ease,
    transform 0.7s ease;
}

.firefly-wings {
  width: 62%;
  height: 38%;
  opacity: 0.8;
  animation: wingTremble 0.18s ease-in-out infinite alternate;
}

.firefly-wings::before,
.firefly-wings::after {
  position: absolute;
  top: 50%;
  width: 48%;
  height: 78%;
  border-radius: 60% 42% 60% 38%;
  content: "";
  background: radial-gradient(ellipse at center, rgba(248, 246, 242, 0.34), rgba(255, 238, 172, 0.12) 46%, transparent 72%);
  filter: blur(0.3px);
}

.firefly-wings::before {
  right: 50%;
  transform: translateY(-50%) rotate(-17deg);
}

.firefly-wings::after {
  left: 50%;
  transform: translateY(-50%) rotate(17deg) scaleX(-1);
}

.firefly-core {
  display: block;
  width: clamp(18px, 3.2vw, 30px);
  height: clamp(30px, 5.2vw, 52px);
  border-radius: 54% 54% 48% 48%;
  background:
    radial-gradient(circle at 50% 28%, rgba(255, 255, 232, 1), rgba(255, 239, 172, 0.96) 22%, rgba(237, 183, 61, 0.92) 54%, rgba(196, 118, 22, 0.78) 100%);
  box-shadow:
    0 0 18px rgba(255, 238, 172, 0.95),
    0 0 56px rgba(255, 213, 89, 0.72),
    0 0 118px rgba(255, 196, 65, 0.3);
  animation: fireflyHover 2.4s ease-in-out infinite;
}

.opening-prompt {
  position: absolute;
  left: 50%;
  bottom: clamp(54px, 9vh, 92px);
  z-index: 2;
  margin: 0;
  color: rgba(248, 246, 242, 0.64);
  font-size: clamp(14px, 2vw, 18px);
  letter-spacing: 0;
  line-height: 1.4;
  text-shadow: 0 0 24px rgba(255, 225, 130, 0.28);
  transform: translateX(-50%);
  white-space: nowrap;
  will-change: transform, opacity;
}

.opening.is-ready {
  cursor: auto;
}

.opening.is-ready::before {
  opacity: 1;
}

.opening.is-bursting {
  pointer-events: none;
}

.opening.is-bursting::before {
  opacity: 1;
  transform: scale(1.35);
}

.opening.is-bursting .opening-landscape {
  opacity: 1;
  transform: translateY(0);
  transition:
    opacity 0.9s ease,
    transform 1.2s ease;
}

.opening.is-bursting .opening-particles {
  opacity: 1;
}

.opening.is-bursting .opening-particles::before {
  animation: particleBurst 1.4s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.opening.is-bursting .opening-particles::after {
  animation: particleBurstWide 1.55s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.opening.is-bursting .firefly-trigger {
  filter: brightness(1.45);
}

@keyframes fireflyHover {
  0%,
  100% {
    transform: translate(-50%, -50%) translate3d(0, -2px, 0) scaleY(1);
  }

  45% {
    transform: translate(-50%, -50%) translate3d(2px, 4px, 0) scaleY(0.94);
  }
}

@keyframes fireflyBreath {
  0%,
  100% {
    opacity: 0.62;
    transform: translate(-50%, -50%) scale(0.84);
  }

  50% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.06);
  }
}

@keyframes wingTremble {
  from {
    transform: translate(-50%, -50%) rotate(-1deg) scaleX(0.96);
  }

  to {
    transform: translate(-50%, -50%) rotate(1deg) scaleX(1.04);
  }
}

@keyframes openingDust {
  to {
    background-position:
      26vw 10vh,
      44vw 38vh;
  }
}

@keyframes particleBurst {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.08) rotate(0deg);
  }

  22% {
    opacity: 1;
  }

  100% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(2.8) rotate(18deg);
  }
}

@keyframes particleBurstWide {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.04) rotate(0deg);
  }

  18% {
    opacity: 1;
  }

  100% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(3.6) rotate(-24deg);
  }
}

.site-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 22px clamp(20px, 5vw, 64px);
  border-bottom: 1px solid rgba(248, 246, 242, 0.16);
  background: linear-gradient(180deg, rgba(17, 17, 21, 0.76), rgba(17, 17, 21, 0));
  backdrop-filter: blur(10px);
  will-change: transform, opacity;
}

.brand {
  font-size: 18px;
  letter-spacing: 0;
  color: var(--gold);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: clamp(14px, 3vw, 34px);
  font-size: 14px;
  color: var(--mist);
}

.nav-links a {
  transition: color 180ms ease;
}

.nav-links a:hover {
  color: var(--gold);
}

.hero {
  position: relative;
  min-height: 100svh;
  display: grid;
  align-items: end;
  overflow: hidden;
  padding: 120px clamp(20px, 6vw, 84px) 92px;
}

.hero-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transform: scale(1.02);
  will-change: transform;
}

.hero-shade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(17, 17, 21, 0.78) 0%, rgba(42, 44, 52, 0.45) 42%, rgba(162, 175, 196, 0.1) 78%),
    linear-gradient(0deg, rgba(17, 17, 21, 0.88) 0%, rgba(162, 175, 196, 0.16) 44%, rgba(228, 200, 208, 0.22) 100%);
}

.hero-content {
  position: relative;
  z-index: 2;
  width: min(760px, 100%);
  transform-origin: left bottom;
}

.eyebrow,
.section-kicker {
  margin: 0 0 18px;
  color: var(--gold);
  font-size: 13px;
  line-height: 1.2;
  text-transform: uppercase;
  letter-spacing: 0;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1 {
  margin-bottom: 20px;
  font-size: clamp(56px, 12vw, 142px);
  line-height: 0.96;
  font-weight: 500;
  text-shadow: 0 22px 70px rgba(0, 0, 0, 0.62);
}

.js-mask-line {
  display: block;
  overflow: hidden;
}

.js-mask-line > span {
  display: inline-block;
  will-change: transform;
}

.hero-copy {
  max-width: 520px;
  margin-bottom: 34px;
  color: var(--mist);
  font-size: clamp(18px, 2.2vw, 25px);
  line-height: 1.8;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
}

.primary-action,
.ghost-action,
.listen-button {
  display: inline-flex;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border-radius: 8px;
  padding: 0 22px;
  border: 1px solid var(--line);
  cursor: pointer;
  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease;
}

.primary-action,
.listen-button {
  color: #111115;
  background: linear-gradient(135deg, var(--soft-white), var(--petal));
  box-shadow: 0 18px 54px rgba(17, 17, 21, 0.26);
}

.ghost-action {
  color: var(--text);
  background: rgba(17, 17, 21, 0.2);
  backdrop-filter: blur(12px);
}

.primary-action:hover,
.ghost-action:hover,
.listen-button:hover {
  transform: translateY(-2px);
  border-color: rgba(248, 246, 242, 0.7);
}

.action-icon {
  width: 18px;
  display: inline-block;
  text-align: center;
}

.scroll-cue {
  position: absolute;
  right: clamp(20px, 5vw, 64px);
  bottom: 34px;
  z-index: 2;
  width: 34px;
  height: 52px;
  border: 1px solid rgba(248, 246, 242, 0.52);
  border-radius: 20px;
}

.scroll-cue span {
  position: absolute;
  top: 10px;
  left: 50%;
  width: 4px;
  height: 9px;
  border-radius: 4px;
  background: var(--gold);
  transform: translateX(-50%);
  animation: drift 1.8s ease-in-out infinite;
}

@keyframes drift {
  0%,
  100% {
    transform: translate(-50%, 0);
    opacity: 0.45;
  }
  50% {
    transform: translate(-50%, 16px);
    opacity: 1;
  }
}

.intro-section,
.listen-section,
.highlights-section {
  position: relative;
  overflow: hidden;
  isolation: isolate;
  padding: clamp(72px, 10vw, 128px) clamp(20px, 6vw, 84px);
  background:
    radial-gradient(circle at 18% 12%, rgba(228, 200, 208, 0.16), transparent 28rem),
    linear-gradient(180deg, rgba(17, 17, 21, 0.82), rgba(17, 17, 21, 0.68) 48%, rgba(42, 44, 52, 0.78));
}

.listen-section {
  min-height: 100svh;
  background:
    radial-gradient(circle at 72% 12%, rgba(248, 246, 242, 0.18), transparent 18rem),
    linear-gradient(180deg, #061022 0%, #0a1835 38%, #1b1828 72%, #2b1220 100%);
}

.fate-bg {
  position: absolute;
  inset: 0;
  z-index: -1;
  overflow: hidden;
  pointer-events: none;
}

.fate-bg::before,
.fate-bg::after {
  position: absolute;
  inset: 0;
  content: "";
}

.fate-bg::before {
  background:
    radial-gradient(circle at 28% 74%, rgba(255, 210, 90, 0.18), transparent 22rem),
    radial-gradient(circle at 78% 44%, rgba(220, 229, 242, 0.22), transparent 24rem),
    linear-gradient(180deg, rgba(4, 15, 35, 0.82), rgba(3, 8, 18, 0.2) 45%, rgba(70, 20, 44, 0.42));
  animation: surfaceRise 12s ease-in-out infinite alternate;
}

.fate-bg::after {
  background-image:
    radial-gradient(circle, rgba(255, 224, 122, 0.95) 0 1px, transparent 2px),
    radial-gradient(circle, rgba(228, 235, 244, 0.88) 0 1px, transparent 2px),
    radial-gradient(circle, rgba(255, 195, 82, 0.62) 0 1.5px, transparent 2.5px);
  background-position:
    12vw 18vh,
    62vw 24vh,
    38vw 66vh;
  background-size:
    20rem 18rem,
    17rem 20rem,
    24rem 24rem;
  opacity: 0.58;
  mix-blend-mode: screen;
  animation: fireflySky 9s linear infinite;
}

.moon-orb,
.waterline,
.peach-grove,
.rising-bubbles {
  position: absolute;
  display: block;
  pointer-events: none;
}

.moon-orb {
  top: clamp(64px, 9vw, 110px);
  right: clamp(28px, 11vw, 150px);
  width: clamp(82px, 12vw, 150px);
  aspect-ratio: 1;
  border-radius: 50%;
  background:
    radial-gradient(circle at 38% 32%, #fff8df, #dfe7f2 56%, rgba(196, 205, 221, 0.24) 72%, transparent 74%);
  box-shadow:
    0 0 46px rgba(232, 239, 248, 0.48),
    0 0 110px rgba(255, 213, 102, 0.12);
  opacity: 0.82;
}

.waterline {
  left: -8vw;
  right: -8vw;
  top: 42%;
  height: 18vh;
  background:
    linear-gradient(180deg, transparent, rgba(248, 246, 242, 0.1) 45%, transparent 72%),
    repeating-linear-gradient(174deg, transparent 0 30px, rgba(226, 235, 246, 0.11) 32px 34px, transparent 36px 58px);
  filter: blur(0.4px);
  opacity: 0.62;
  transform: rotate(-2deg);
  animation: waterFloat 7s ease-in-out infinite alternate;
}

.peach-grove {
  left: -5vw;
  right: -5vw;
  bottom: -2px;
  height: 30vh;
  background:
    radial-gradient(ellipse at 14% 78%, rgba(255, 171, 183, 0.34), transparent 18%),
    radial-gradient(ellipse at 34% 66%, rgba(228, 200, 208, 0.42), transparent 17%),
    radial-gradient(ellipse at 58% 76%, rgba(255, 186, 156, 0.35), transparent 19%),
    radial-gradient(ellipse at 82% 68%, rgba(228, 200, 208, 0.4), transparent 18%),
    linear-gradient(180deg, transparent 0%, rgba(49, 11, 25, 0.72) 56%, rgba(3, 3, 4, 0.96) 100%);
  opacity: 0.76;
}

.rising-bubbles {
  inset: 0;
  background-image:
    radial-gradient(circle, transparent 0 6px, rgba(225, 237, 247, 0.36) 7px, transparent 8px),
    radial-gradient(circle, transparent 0 3px, rgba(248, 246, 242, 0.28) 4px, transparent 5px);
  background-position:
    18vw 86vh,
    72vw 92vh;
  background-size:
    18rem 25rem,
    13rem 18rem;
  opacity: 0.36;
  animation: bubbleRise 11s linear infinite;
}

.dual-player {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(220px, 0.58fr) minmax(320px, 1fr);
  gap: clamp(28px, 5vw, 72px);
  align-items: center;
  max-width: 1120px;
  margin: clamp(28px, 5vw, 56px) auto 0;
  padding: clamp(22px, 4vw, 42px);
  border: 1px solid rgba(248, 246, 242, 0.2);
  border-radius: 8px;
  background:
    linear-gradient(135deg, rgba(6, 16, 34, 0.78), rgba(43, 18, 32, 0.68)),
    rgba(3, 3, 4, 0.44);
  box-shadow: 0 34px 110px rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(18px);
}

.orb-shell {
  display: grid;
  justify-items: center;
  gap: 18px;
}

.orb-stage {
  position: relative;
  width: clamp(190px, 24vw, 278px);
  aspect-ratio: 1;
  display: grid;
  place-items: center;
  overflow: visible;
  border-radius: 50%;
  background: transparent;
}

.turntable-state {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  transition:
    opacity 0.72s ease,
    transform 0.9s cubic-bezier(0.16, 1, 0.3, 1),
    filter 0.72s ease;
}

.turntable-state {
  opacity: 1;
  transform: scale(1);
}

.fate-orb {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border: 0;
  border-radius: 50%;
  color: rgba(248, 246, 242, 0.92);
  background: transparent;
  cursor: pointer;
  filter: drop-shadow(0 0 30px rgba(255, 211, 104, 0.22));
  transform: translate3d(0, 0, 0);
  transition:
    transform 0.75s cubic-bezier(0.16, 1, 0.3, 1),
