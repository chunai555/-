  content: "";
  opacity: 0;
  transition: opacity 0.55s ease;
}

.border-glow-card::before {
  border: 1px solid transparent;
  background:
    linear-gradient(var(--card-bg) 0 100%) padding-box,
    var(--gradient-one) border-box,
    var(--gradient-two) border-box,
    var(--gradient-three) border-box,
    var(--gradient-four) border-box,
    var(--gradient-five) border-box,
    var(--gradient-six) border-box,
    var(--gradient-seven) border-box,
    linear-gradient(135deg, rgba(255, 255, 255, 1), rgba(255, 255, 255, 0.42)) border-box;
  mask-image:
    conic-gradient(
      from var(--cursor-angle) at center,
      black calc(var(--cone-spread) * 1%),
      transparent calc((var(--cone-spread) + 10) * 1%),
      transparent calc((100 - var(--cone-spread) - 10) * 1%),
      black calc((100 - var(--cone-spread)) * 1%)
    );
}

.border-glow-card::after {
  background:
    var(--gradient-one),
    var(--gradient-two),
    var(--gradient-three),
    var(--gradient-four),
    var(--gradient-five),
    var(--gradient-six),
    var(--gradient-seven),
    linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.35));
  mix-blend-mode: soft-light;
  opacity: calc(0.7 * (var(--edge-proximity) - var(--color-sensitivity)) / (100 - var(--color-sensitivity)));
}

.border-glow-card .flow-light {
  border: 1px solid transparent;
  background:
    linear-gradient(var(--card-bg) 0 100%) padding-box,
    conic-gradient(
      from 0deg at 50% 50%,
      rgba(255, 255, 255, 0.08) 0deg,
      rgba(255, 255, 255, 0.32) 24deg,
      rgba(255, 255, 255, 1) 38deg,
      rgba(255, 255, 255, 0.72) 54deg,
      rgba(255, 255, 255, 0.14) 78deg,
      rgba(255, 255, 255, 0.08) 170deg,
      rgba(255, 255, 255, 0.46) 222deg,
      rgba(255, 255, 255, 1) 252deg,
      rgba(255, 255, 255, 0.18) 290deg,
      rgba(255, 255, 255, 0.08) 360deg
    ) border-box;
  opacity: 1;
  animation: borderDiscSpin 3.2s linear infinite, borderPulse 2.4s ease-in-out infinite;
  animation-delay: var(--flow-delay, 0s), 0s;
  filter: drop-shadow(0 0 16px rgba(255, 255, 255, 0.42)) drop-shadow(0 0 42px rgba(255, 255, 255, 0.22));
  overflow: visible;
}

.border-glow-card .flow-light::before,
.border-glow-card .flow-light::after {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  content: "";
  pointer-events: none;
}

.border-glow-card .flow-light::before {
  inset: -2px;
  background:
    linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.18), transparent),
    radial-gradient(circle at 76% 7%, rgba(255, 255, 255, 0.55), transparent 16%),
    radial-gradient(circle at 18% 92%, rgba(255, 255, 255, 0.35), transparent 22%);
  filter: blur(6px);
  opacity: 0.88;
  mix-blend-mode: screen;
}

.border-glow-card .flow-light::after {
  inset: -1px;
  padding: 1px;
  border-radius: inherit;
  background:
    linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.04) 32%, #fff 48%, rgba(255, 255, 255, 0.34) 58%, transparent 76%);
  background-size: 240% 100%;
  opacity: 1;
  filter: blur(0.2px) drop-shadow(0 0 12px rgba(255, 255, 255, 0.8));
  animation: borderSweepX 2.2s ease-in-out infinite;
  animation-delay: var(--flow-delay, 0s);
  mask:
    linear-gradient(#000 0 0) padding-box,
    linear-gradient(#000 0 0);
  -webkit-mask:
    linear-gradient(#000 0 0) padding-box,
    linear-gradient(#000 0 0);
  mask-composite: exclude;
  -webkit-mask-composite: xor;
}

.border-glow-card:hover::before,
.border-glow-card.is-sweeping::before {
  opacity: calc((var(--edge-proximity) - var(--color-sensitivity)) / (100 - var(--color-sensitivity)));
}

.border-glow-card:hover .edge-light,
.border-glow-card.is-sweeping .edge-light {
  opacity: calc((var(--edge-proximity) - var(--edge-sensitivity)) / (100 - var(--edge-sensitivity)));
}

.border-glow-card .edge-light {
  inset: calc(var(--glow-padding) * -1);
  pointer-events: none;
  mix-blend-mode: screen;
  mask-image: conic-gradient(from var(--cursor-angle) at center, black 2.5%, transparent 11%, transparent 89%, black 97.5%);
}

.border-glow-card .edge-light::before {
  position: absolute;
  inset: var(--glow-padding);
  border-radius: inherit;
  content: "";
  box-shadow:
    inset 0 0 0 1px rgba(248, 246, 242, 0.92),
    inset 0 0 24px rgba(255, 255, 255, 0.56),
    0 0 28px rgba(255, 255, 255, 0.68),
    0 0 68px rgba(255, 255, 255, 0.48),
    0 0 118px rgba(255, 255, 255, 0.28);
}

.border-glow-inner {
  position: relative;
  z-index: 1;
  min-height: 280px;
  padding: clamp(26px, 4vw, 48px);
  border-radius: inherit;
  background:
    radial-gradient(circle at 86% 8%, rgba(255, 255, 255, 0.11), transparent 28%),
    radial-gradient(circle at 8% 92%, rgba(255, 255, 255, 0.075), transparent 32%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.055), transparent 42%),
    linear-gradient(135deg, rgba(17, 17, 21, 0.96), rgba(42, 44, 52, 0.92));
  overflow: hidden;
}

@keyframes borderDiscSpin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes borderPulse {
  0%,
  100% {
    filter: drop-shadow(0 0 14px rgba(255, 255, 255, 0.34)) drop-shadow(0 0 36px rgba(255, 255, 255, 0.18));
  }

  50% {
    filter: drop-shadow(0 0 24px rgba(255, 255, 255, 0.68)) drop-shadow(0 0 68px rgba(255, 255, 255, 0.34));
  }
}

@keyframes borderSweepX {
  0% {
    background-position: 140% 50%;
    opacity: 0.28;
  }

  18%,
  72% {
    opacity: 1;
  }

  100% {
    background-position: -80% 50%;
    opacity: 0.32;
  }
}

.highlights-section article span {
  display: block;
  margin-bottom: 50px;
  color: var(--leaf-bright);
  font-size: 13px;
}

.highlights-section article h3 {
  margin-bottom: 16px;
  color: var(--gold);
  font-size: 26px;
  font-weight: 500;
}

.highlights-section article p {
  margin-bottom: 0;
  color: var(--muted);
  line-height: 1.8;
}

.visual-section {
  position: relative;
  min-height: 72svh;
  display: grid;
  align-items: center;
  overflow: hidden;
  padding: clamp(72px, 10vw, 128px) clamp(20px, 6vw, 84px);
}

.visual-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.72;
  will-change: transform;
}

.visual-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(17, 17, 21, 0.86), rgba(42, 44, 52, 0.38)),
    linear-gradient(0deg, rgba(17, 17, 21, 0.82), rgba(162, 175, 196, 0.14));
}

.visual-content {
  position: relative;
  z-index: 2;
  width: min(680px, 100%);
  will-change: transform, opacity;
}

.visual-content p:not(.section-kicker) {
  color: var(--muted);
  font-size: 18px;
  line-height: 1.9;
}

.site-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 28px clamp(20px, 6vw, 84px);
  color: rgba(248, 246, 242, 0.66);
  background: #111115;
}

.site-footer p {
  margin: 0;
}

.site-footer a {
  color: var(--gold);
}

@media (max-width: 820px) {
  .site-header {
    padding: 16px 20px;
  }

  .nav-links {
    gap: 14px;
  }

  .hero {
    min-height: 100svh;
    padding: 104px 20px 82px;
  }

  .hero-shade {
    background:
      linear-gradient(90deg, rgba(17, 17, 21, 0.8), rgba(42, 44, 52, 0.34)),
      linear-gradient(0deg, rgba(17, 17, 21, 0.95), rgba(162, 175, 196, 0.2) 62%, rgba(228, 200, 208, 0.32));
  }

  .intro-grid,
  .track-panel,
  .highlights-section,
  .dual-player {
    grid-template-columns: 1fr;
  }

  .track-panel {
    padding: 16px;
  }

  .highlights-section article {
    min-height: 220px;
  }

  .border-glow-card {
    --border-radius: 20px;
    --glow-padding: 20px;
  }

  .border-glow-inner {
    min-height: 220px;
  }

  .site-footer {
    flex-direction: column;
    align-items: flex-start;
  }

  .destiny-section {
    min-height: clamp(760px, 92svh, 980px);
    grid-template-columns: 1fr;
    grid-template-areas:
      "display"
      "intro"
      "cards";
    align-content: start;
    padding-top: 58px;
    padding-bottom: 42px;
    gap: 14px;
  }

  .scroll-painting {
    justify-self: stretch;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: 100%;
  }

  .section-display-inline {
    white-space: normal;
  }

  .destiny-section .section-display-inline {
    margin-bottom: 4px;
  }
}

@media (max-width: 560px) {
  .brand {
    font-size: 16px;
  }

  .nav-links {
    display: none;
  }

  .hero-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .primary-action,
  .ghost-action,
  .listen-button {
    width: 100%;
  }

  .version-switcher button {
    flex: 1 1 100%;
  }

  .painting-card {
    min-height: 220px;
  }

  .scroll-cue {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.001ms !important;
  }

  body.is-loading {
    overflow: auto;
  }

  .opening {
    display: none;
  }

  .track-art {
    clip-path: none;
  }

  .border-glow-card .flow-light {
    animation: none;
  }

  .border-glow-card .flow-light::before {
    animation: none;
  }

  .fate-bg::before,
  .fate-bg::after,
  .rising-bubbles,
  .waterline,
  .orb-core,
  .orb-progress,
  .lyric-line span {
    animation: none;
  }
}
